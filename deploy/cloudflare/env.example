# Copy to deploy/cloudflare/.env (git-ignored) — or let scripts/cloudflare_setup.py --write-env create it.
# Every value below is either an identifier (safe) or a placeholder in <angle brackets>. Never commit real values;
# a credential that was ever pasted into a chat, an issue or a screenshot must be rotated (SECURITY.md).

# --- written by scripts/cloudflare_setup.py --------------------------------------------------------------------
GODOTAI_PUBLIC_HOST=<games.example.com>                 # the hostname inside your Cloudflare zone
GODOTAI_ACCESS_TEAM_DOMAIN=<myteam.cloudflareaccess.com> # Zero Trust team domain
GODOTAI_ACCESS_AUD=<application audience tag>            # Zero Trust → Access → Applications → your app → Overview
CF_ACCOUNT_ID=<account id>                               # identifier, not a secret
TUNNEL_ID=<tunnel uuid>
TUNNEL_TOKEN=<tunnel token — secret, written by the script, never printed>

# --- your model server (pick the compose profile that matches) ------------------------------------------------
# gpu-base / gpu-lora (vLLM): the chat talks to http://model:8000/v1 and asks for the served name "godotai"
GODOTAI_MODEL=godotai
OPENAI_BASE_URL=http://model:8000/v1
GODOTAI_BASE_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct         # Apache-2.0 open weights (model card, read 2026-09-26)
VLLM_MAX_MODEL_LEN=32768
# gpu-lora only — say so honestly in the UI (kind becomes "open-weight base + your own fine-tune"):
# GODOTAI_MODEL_KIND=fine_tune
# GODOTAI_ADAPTER=/adapters/godotai
# GODOTAI_ADAPTER_DIR=../../training/output/godotai-lora
# cpu (Ollama) — slow, for trying the site without a GPU:
# OPENAI_BASE_URL=http://ollama:11434/v1
# GODOTAI_MODEL=qwen2.5-coder:7b

# --- optional ---------------------------------------------------------------------------------------------------
# GITHUB_TOKEN=<fine-grained token with Contents/Actions write on your game repos>   # enables the GitHub tools
# HF_TOKEN=<hugging face token>                                                       # only for gated base models
